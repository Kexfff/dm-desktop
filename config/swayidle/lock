#!/bin/sh
# Lock the screen with hyprlock, and return only once niri has confirmed the lock
# (hyprlock logs "onLockLocked"), at most after 3 s. swayidle runs this before sleep
# and waits for it (-w), so the laptop doesn't suspend before the screen is locked.
pgrep -x hyprlock >/dev/null && exit 0
log="${XDG_RUNTIME_DIR:-/tmp}/hyprlock.log"
: >"$log"
setsid -f hyprlock >"$log" 2>&1
i=0
while [ "$i" -lt 60 ]; do
    grep -q onLockLocked "$log" && exit 0
    sleep 0.05
    i=$((i + 1))
done
